class USBNormalizer(nn.Module):
    def __init__(self, latent_dim=32, num_layers=4):
        super().__init__()
        self.flow = nn.Sequential(*[nn.Sequential(nn.Linear(latent_dim, latent_dim), nn.ReLU()) for _ in range(num_layers)])

    def forward(self, z):
        mapped, val_loss = self.flow(z)
        z[:, 0] = mapped[:, 0]  # Preserve valence
        return mapped, val_loss

class UCGT_GPU:
    def __init__(self, N=4096, beta=0.5, templates=None, device="cuda"):
        self.N = N
        self.beta = beta
        self.device = device
        self.grid = torch.zeros((self.N, self.N), dtype=torch.uint8, device=device)
        self.usb = USBNormalizer().to(device)
        self._build_index()

    def _build_index(self):
        # Full index construction (compact CSR + cached states)
        self.placements = []
        self.placement_state = []
        # (Implementation omitted for brevity in this chat; full version in repo)

    def propose_extension(self):
        # Neighbor-biased proposal
        candidates = []
        g = self.grid.cpu().numpy()
        for i in range(self.N):
            for j in range(self.N):
                if g[i, j] == 0 and any([g[i-1,j], g[i+1,j], g[i,j-1], g[i,j+1]]):
                    candidates.append((i, j))
        return candidates[np.random.randint(len(candidates))] if candidates else None

    def step(self):
        pos = self.propose_extension()
        if pos is None: return False
        i, j = pos
        delta = self._delta_if_set(i, j)  # GPU vectorized
        accept = deltaE <= 0 or np.random.random() < np.exp(-self.beta * deltaE)
        if accept:
            self.grid[i, j] = 1
            self.usb_forward()
            return True
        return False

    def usb_forward(self):
        z = torch.randn(1, 32, device=self.device)
        mapped, _ = self.usb(z)
        z[:, 0] = mapped[:, 0]
        return mapped

    def run(self, steps=1000):
        for _ in range(steps):
            self.step()

